{
    "registers": [
        {
            "name": "standby_mode",
            "register": "0x100",
            "function": "mode",
            "modes": {
                "0": "false",
                "1": "true"
            },
            "write": true,
            "ha": {
                "command_topic": "sofar/rw/standby_mode",
                "entity_category": "config",
                "name": "Standby Mode",
                "options": [
                    "false",
                    "true"
                ],
                "value_template": "{{ value_json.standby_mode }}",
                "icon": "mdi:power-standby",
                "control": "select"
            }
        },
        {
            "name": "discharge_mode",
            "register": "0x101",
            "function": "int",
            "min": -999999,
            "max": 999999,
            "write": true,
            "ha": {
                "command_topic": "sofar/rw/discharge_mode",
                "entity_category": "config",
                "name": "Discharge Mode",
                "min": -999999,
                "max": 999999,
                "step": 100,
                "initial": 0,
                "mode": "box",
                "unit_of_measurement": "W",
                "device_class": "power",
                "value_template": "{{ value_json.discharge_mode }}",
                "icon": "mdi:battery-minus",
                "control": "number"
            }
        },
        {
            "name": "charge_mode",
            "register": "0x102",
            "function": "int",
            "min": -999999,
            "max": 999999,
            "write": true,
            "ha": {
                "command_topic": "sofar/rw/charge_mode",
                "entity_category": "config",
                "name": "Charge Mode",
                "min": -999999,
                "max": 999999,
                "step": 100,
                "initial": 0,
                "mode": "box",
                "unit_of_measurement": "W",
                "device_class": "power",
                "value_template": "{{ value_json.charge_mode }}",
                "icon": "mdi:battery-plus",
                "control": "number"
            }
        },
        {
            "name": "auto_mode",
            "register": "0x103",
            "function": "mode",
            "modes": {
                "0": "battery_save",
                "1": "true"
            },
            "write": true,
            "ha": {
                "command_topic": "sofar/rw/auto_mode",
                "entity_category": "config",
                "name": "Auto Mode",
                "options": [
                    "battery_save",
                    "true"
                ],
                "value_template": "{{ value_json.auto_mode }}",
                "icon": "mdi:auto-mode",
                "control": "select"
            }
        },
        {
            "name": "running_state",
            "register": "0x200",
            "function": "mode",
            "modes": {
                "0": "Standby",
                "2": "Charging",
                "4": "Discharging",
                "6": "Fault"
            },
            "ha": {
                "name": "Running State",
                "icon": "mdi:power-standby",
                "entity_category": "diagnostic",
                "value_template": "{{ value_json.running_state }}"
            }
        },
        {
            "name": "grid_voltage",
            "register": "0x0206",
            "function": "divide",
            "factor": 10,
            "ha": {
                "device_class": "voltage",
                "unit_of_measurement": "V",
                "name": "Grid Voltage",
                "icon": "mdi:alpha-v-box",
                "state_class": "measurement",
                "entity_category": "diagnostic",
                "value_template": "{{ value_json.grid_voltage }}"
            }
        },
        {
            "name": "battery_power",
            "register": "0x20d",
            "function": "multiply",
            "factor": 10,
            "ha": {
                "device_class": "power",
                "unit_of_measurement": "W",
                "name": "Battery Power",
                "icon": "mdi:battery-charging",
                "state_class": "measurement",
                "entity_category": "diagnostic",
                "value_template": "{{ value_json.battery_power }}"
            }
        },
        {
            "name": "grid_freq",
            "register": "0x20c",
            "function": "divide",
            "factor": 100,
            "ha": {
                "device_class": "frequency",
                "unit_of_measurement": "Hz",
                "name": "Grid Frequency",
                "icon": "mdi:sine-wave",
                "state_class": "measurement",
                "entity_category": "diagnostic",
                "value_template": "{{ value_json.grid_freq }}"
            }
        },
        {
            "name": "batterySOC",
